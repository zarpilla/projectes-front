server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Redirects carry only the path ("Location: /tasks"): behind the site's nginx
    # an absolute one would point at http://<host>:80.
    absolute_redirect off;

    # Keep the app out of search engines. Repeated in every location that
    # defines its own add_header, since nginx does not inherit them.
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Security: block direct download of sensitive credential files (defense in depth).
    location ~* \.(p12|pfx|pem|key|crt|cer|jks|kdb)$ {
        return 403;
    }

    # The app was served under /stats/ until it moved to the root of the site.
    # Browsers that registered the old service worker (scope /stats/) fetch it
    # from here; it must answer directly (a redirected worker script is
    # rejected), so they get the kill switch and drop it.
    location = /stats/service-worker.js {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files /service-worker.js =404;
    }

    # Old addresses (printed QR labels, e-mails, bookmarks): /stats/x → /x, and
    # the app's administration screens /stats/admin/x → /administracio/x (/admin
    # is Strapi's). Query strings are kept, and browsers keep the "#/…" of the
    # older hash links, which the app turns into a path. Never remove.
    location = /stats {
        return 301 /;
    }
    location ^~ /stats/ {
        rewrite ^/stats/admin(/.*)?$ /administracio$1 permanent;
        rewrite ^/stats/(.*)$ /$1 permanent;
    }

    # Service worker should never be cached
    location = /service-worker.js {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Built files carry a content hash in their name
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    # Force no caching for HTML files - this is critical for service worker updates
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Last-Modified $date_gmt;
        add_header ETag "";
        if_modified_since off;
        # Add a unique query parameter to force cache busting
        add_header X-Cache-Bust $msec;
    }

    # config.js is written per site at container start
    location = /config.js {
        expires -1;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # App routes: serve index.html for SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }
}
